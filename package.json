{
  "name": "one-more-person",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Conditional seat relays: keep your existing place unless the entire exchange succeeds.",
  "engines": {
    "node": ">=22.10"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/build-web.mjs && node scripts/serve.mjs",
    "build": "node scripts/compile.mjs && node scripts/build-web.mjs",
    "build:contracts": "node scripts/compile.mjs",
    "build:web": "node scripts/build-web.mjs",
    "stage:sites": "node scripts/stage-sites.mjs",
    "test": "node --test tests/*.test.mjs",
    "demo:local": "node scripts/demo-local.mjs",
    "demo:room": "node scripts/serve-rehearsal.mjs",
    "verify:events": "node scripts/verify-events.mjs",
    "verify:chain": "node scripts/verify-chain.mjs",
    "mojo": "node scripts/mojo.mjs",
    "check:network": "node scripts/check-network.mjs"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "esbuild": "0.25.12",
    "hardhat": "3.0.9",
    "qrcode": "1.5.4",
    "solc": "0.8.30",
    "viem": "2.37.9",
    "yaml": "2.8.1"
  }
}
